HISSIYAT_SERVICE_NAME=Hissiyat API
HISSIYAT_ENVIRONMENT=development

# Optional for liveness; all three credentials are required for readiness.
# Match the root .env values. Use a generated local-only password.
HISSIYAT_DATABASE_HOST=127.0.0.1
HISSIYAT_DATABASE_PORT=55432
HISSIYAT_DATABASE_NAME=hissiyat_dev
HISSIYAT_DATABASE_USER=hissiyat_local
HISSIYAT_DATABASE_PASSWORD=
HISSIYAT_DATABASE_CONNECT_TIMEOUT=3
HISSIYAT_DATABASE_POOL_TIMEOUT=2
HISSIYAT_DATABASE_STATEMENT_TIMEOUT_MS=3000
